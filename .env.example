# Copy to .env and fill in. Never commit .env.

# --- LLM (optional; enables Claude news sentiment + daily brief) ---
# Alternatively run `ant auth login` once and leave this blank.
ANTHROPIC_API_KEY=

# --- Zerodha Kite Connect (optional) ---
KITE_API_KEY=
KITE_API_SECRET=
# Filled by `qd broker login zerodha` each trading day (sessions expire daily):
KITE_ACCESS_TOKEN=

# --- Groww Trade API (optional) ---
# Option A: API key + secret (approve daily on Groww Cloud API Keys page)
GROWW_API_KEY=
GROWW_API_SECRET=
# Option B: TOTP flow
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=

# --- Live trading safety interlock ---
# Live orders are refused unless this is exactly I_UNDERSTAND_THE_RISK
QD_LIVE_CONFIRM=
